<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12.dp"
    android:layout_marginVertical="6.dp"
    app:cardElevation="3.dp"
    app:cardCornerRadius="10.dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16.dp">

        <TextView
            android:id="@+id/tvVoluntarioId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voluntario: ID"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFechaSolicitud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.dp"
            android:text="Solicitado el: dd/MM/yyyy HH:mm"
            android:textColor="@android:color/darker_gray"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAsignarTurno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8.dp"
            android:text="Asignar Turno" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>